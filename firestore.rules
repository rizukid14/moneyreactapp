rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// MoneyApp / Monetiq — Firestore Security Rules
//
// Tujuan: membatasi akses data per pengguna & per keluarga, serta membuat
// dokumen premium menjadi server-authoritative (hanya bisa ditulis oleh
// webhook Lynk.id / Cloud Function lewat Admin SDK).
//
// Lihat FIRESTORE_RULES.md untuk panduan deploy dan hal yang perlu disiapkan.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Data pribadi pengguna ────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Koleksi biasa (transactions, assets, categories, debts, goals, ...)
    match /users/{uid}/{col}/{docId} {
      allow read, write: if isOwner(uid) && col != 'settings';
    }

    // Pengaturan: boleh dibaca pemilik. TAPI dokumen premium & kode aktivasi
    // hanya boleh ditulis server (mencegah self-grant premium dari DevTools).
    match /users/{uid}/settings/{key} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && key != 'premium' && key != 'premiumActivationCode';
    }

    // ── Keluarga / workspace bersama ─────────────────────────────────────────
    match /families/{familyId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        request.auth.uid in request.resource.data.members
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Subkoleksi keluarga (transactions, assets, settings, dsb) — hanya anggota
    match /families/{familyId}/{col}/{docId} {
      allow read, write: if signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    // ── Shared split bill (dibagikan lewat link) ─────────────────────────────
    // CATATAN KEAMANAN: read publik diperlukan agar penerima link bisa melihat
    // rincian. Token pada URL (K10) TIDAK bisa ditegakkan di Rules. Jika ingin
    // read privat, pindahkan pembacaan ke Cloud Function yang memverifikasi token.
    match /shared_splits/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }

    // Default: tolak semua yang tidak disebutkan di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
