rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// MoneyApp / Monetiq — Firestore Security Rules (merged)
//
// Base = rules existing, plus:
//   • Fix join/leave: non-owner members may change ONLY the `members` array.
//   • Protect `settings/premium`: server-authoritative (client cannot write it).
//
// Lihat FIRESTORE_RULES.md untuk panduan deploy & catatan.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Data privat pengguna (Personal Workspace) ───────────────────────────
    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId);
    }
    // Non-settings collections (transactions, assets, categories, ...)
    match /users/{userId}/{col}/{docId} {
      allow write: if isOwner(userId) && col != 'settings';
    }
    // Settings: owner may write all EXCEPT the server-authoritative `premium`.
    match /users/{userId}/settings/{key} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && key != 'premium';
    }

    // ── Shared Split & Trip ──────────────────────────────────────────────────
    match /shared_splits/{splitId} {
      // Link publik: siapa saja boleh melihat rincian.
      allow read: if true;
      // Hanya pengguna login yang boleh membuat link.
      allow create: if signedIn();
      // Hanya pembuat yang boleh mengubah/menghapus.
      allow update, delete: if signedIn() && request.auth.uid == resource.data.creatorId;
    }

    // ── Family / Workspace bersama ────────────────────────────────────────────
    match /families/{familyId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn() && request.auth.uid in request.resource.data.members;

      // Owner: bebas. Anggota: HANYA boleh mengubah `members` (join/leave),
      // tidak boleh mengubah name/ownerId/joinCode. (fix join/leave)
      allow update: if signedIn() && (
        request.auth.uid == resource.data.ownerId ||
        (
          (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.joinCode == resource.data.joinCode
        )
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      // Subkoleksi (transactions, assets, settings, ...) — hanya anggota.
      match /{document=**} {
        allow read, write: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
      }
    }

    // Default: tolak semua yang tidak disebutkan di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
